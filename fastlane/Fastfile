# frozen_string_literal: true

require "shellwords"

# iOS delivery lanes. PR-level compile/test runs in .github/workflows/ci-ios.yml
# (plain Flutter, no signing); these lanes are the signing + upload paths only.
#
# The Xcode project/workspace is a standard Flutter one: the app target and
# scheme are both named "Runner" and `flutter build ipa` produces the archive.

default_platform(:ios)

PROJECT_ROOT = File.expand_path("..", __dir__)
IOS_DIR = File.join(PROJECT_ROOT, "ios")
XCODEPROJ = File.join(IOS_DIR, "Runner.xcodeproj")
SCHEME = "Runner"
BUNDLE_ID = ENV["APP_IDENTIFIER"] || "gift.wishtogether"
TEAM_ID = ENV["DEVELOPMENT_TEAM"] || "CD8XP2U645"
EXPORT_OPTIONS_PATH = File.join(IOS_DIR, "ExportOptions.plist")

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT"),
    is_key_content_base64: true
  )
end

# match names the App Store profile after the bundle id; use the mapping it
# reports so a renamed profile still resolves.
def appstore_profile_name
  mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}
  mapping[BUNDLE_ID] || "match AppStore #{BUNDLE_ID}"
end

# Fetch the signing assets and switch the project to manual signing with the
# match profile, returning the profile name for ExportOptions.
def install_appstore_signing
  setup_ci if ENV["CI"]
  match(type: "appstore", readonly: true, app_identifier: BUNDLE_ID)

  profile = appstore_profile_name
  update_code_signing_settings(
    use_automatic_signing: false,
    path: XCODEPROJ,
    team_id: TEAM_ID,
    targets: [SCHEME],
    bundle_identifier: BUNDLE_ID,
    profile_name: profile,
    code_sign_identity: "Apple Distribution"
  )
  profile
end

def write_export_options(profile)
  File.write(EXPORT_OPTIONS_PATH, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>method</key>
      <string>app-store</string>
      <key>signingStyle</key>
      <string>manual</string>
      <key>teamID</key>
      <string>#{TEAM_ID}</string>
      <key>provisioningProfiles</key>
      <dict>
        <key>#{BUNDLE_ID}</key>
        <string>#{profile}</string>
      </dict>
    </dict>
    </plist>
  PLIST
end

# TestFlight's marketing version comes from pubspec.yaml (Flutter's source of
# truth for `version:`); app_store_release takes it from the release tag/input.
def pubspec_version
  version = File.read(File.join(PROJECT_ROOT, "pubspec.yaml"))[/^version:\s*(\S+)/, 1]
  UI.user_error!("Could not read `version:` from pubspec.yaml") unless version
  version.split("+").first
end

# App Store Connect rejects a build number that is not above the highest already
# uploaded for the app, and `github.run_number` counts per workflow — the two
# release workflows would otherwise collide. Resolve ASC's latest and never go
# below the run-number floor.
def resolve_build_number
  returned = latest_testflight_build_number(api_key: asc_api_key, initial_build_number: 1).to_i
  latest = lane_context[SharedValues::LATEST_TESTFLIGHT_BUILD_NUMBER].to_i
  next_build = [returned, latest + 1].max

  floor = ENV.fetch("BUILD_NUMBER", "1").to_i
  next_build = [next_build, floor].max if floor.positive? && floor < 10_000_000

  UI.message("Uploading build number #{next_build} (App Store Connect latest: #{latest}).")
  next_build
rescue StandardError => e
  UI.important("Could not read the latest build from App Store Connect (#{e.message}); using BUILD_NUMBER.")
  ENV.fetch("BUILD_NUMBER", "1")
end

# Surface the resolved number to the workflow so the PR comment can quote it.
def publish_build_number(build_number)
  env_file = ENV["GITHUB_ENV"]
  return unless env_file && File.exist?(env_file)

  File.open(env_file, "a") { |file| file.puts("RESOLVED_BUILD_NUMBER=#{build_number}") }
end

def ipa_path
  ipa = Dir[File.join(PROJECT_ROOT, "build/ios/ipa/*.ipa")].max_by { |f| File.mtime(f) }
  UI.user_error!("No .ipa found under build/ios/ipa — did `flutter build ipa` run?") unless ipa
  ipa
end

# The DSN is a repository variable because it is public: it ships inside the app
# and only names where events go. Without it a shipped build reports nothing, so
# a missing value is a configuration error, not a reason to carry on.
def sentry_dsn
  dsn = ENV.fetch("SENTRY_DSN", "").strip
  UI.user_error!("SENTRY_DSN is not set; a shipped build must report to Sentry") if dsn.empty?
  dsn
end

def build_ipa(marketing_version:, build_number:)
  Dir.chdir(PROJECT_ROOT) do
    sh(
      "flutter build ipa --release " \
      "--export-options-plist=#{Shellwords.escape(EXPORT_OPTIONS_PATH)} " \
      "--build-name=#{Shellwords.escape(marketing_version.to_s)} " \
      "--build-number=#{Shellwords.escape(build_number.to_s)} " \
      "--dart-define=WT_SENTRY_DSN=#{Shellwords.escape(sentry_dsn)}"
    )
  end
end

# Uploads the dSYMs the build just produced. The organisation and project ids are
# exported by scripts/sentry-identity.mjs in the workflow (parsed from the DSN), so
# the repository stores no Sentry slug.
#
# SENTRY_RELEASE names the release record the plugin creates and finalises. The
# dSYM upload itself carries no release or dist — Sentry pairs symbols with events
# by debug id — and the dist events report (`ios-<CFBundleVersion>`) comes from the
# app, not from here.
#
# Runs before the upload to Apple so a failed upload aborts the release instead of
# shipping a build whose stack traces cannot be symbolicated.
def upload_symbols(build_number:)
  missing = %w[SENTRY_ORG SENTRY_PROJECT SENTRY_AUTH_TOKEN].find do |name|
    ENV.fetch(name, "").strip.empty?
  end
  UI.user_error!("#{missing} is not set; refusing to ship without a symbol upload") if missing

  # The plugin uploads whatever debug files it finds and succeeds even when it
  # finds none, so a build with dSYM generation disabled would ship
  # unsymbolicated while every step reported success. Refuse instead.
  if Dir[File.join(PROJECT_ROOT, "build/ios/archive/**/*.dSYM")].empty?
    UI.user_error!(
      "no dSYM in build/ios/archive; refusing to ship an unsymbolicated build"
    )
  end

  Dir.chdir(PROJECT_ROOT) do
    Fastlane::Helper.with_env_values("SENTRY_RELEASE" => "wishtogether@#{build_number}") do
      sh("dart run sentry_dart_plugin --sentry-define=upload_source_maps=false")
    end
  end
end

platform :ios do
  desc "Upload a release build to TestFlight (internal testers)"
  lane :testflight_release do
    profile = install_appstore_signing
    write_export_options(profile)

    build_number = resolve_build_number
    publish_build_number(build_number)
    build_ipa(marketing_version: pubspec_version, build_number: build_number)
    upload_symbols(build_number: build_number)

    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      uses_non_exempt_encryption: false
    )
  end

  desc "Upload and submit a release to the App Store"
  lane :app_store_release do
    profile = install_appstore_signing
    write_export_options(profile)

    marketing_version = ENV.fetch("RELEASE_VERSION")
    build_number = resolve_build_number
    publish_build_number(build_number)
    build_ipa(marketing_version: marketing_version, build_number: build_number)
    upload_symbols(build_number: build_number)

    upload_to_app_store(
      api_key: asc_api_key,
      ipa: ipa_path,
      # Passing the version lets deliver create/confirm the editable App Store
      # version; without it `submit_for_review` fails when no draft exists yet.
      app_version: marketing_version,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      precheck_default_rule_level: :error
    )
  end
end

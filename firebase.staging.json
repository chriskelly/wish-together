{
  "hosting": {
    "site": "wish-together-staging",
    "public": "build/web",
    "appAssociation": "NONE",
    "ignore": ["firebase.json", "firebase.staging.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/support",
        "destination": "/support.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "database": "staging",
    "rules": "firestore.rules"
  }
}

rules_version = '2';

// Content writes are owner-only. The one exception is an item's `claims` map,
// where any reader of that wishlist's items may add or remove their own key.
//
// Reads are open to any signed-in user, except listing groups (members only)
// and any item whose wishlist has never been shared. Anything finer needs a
// join across documents, which Firestore rules cannot express.
//
// Signing in is the only trust boundary the rules can see: the app has no
// allow-list, so "signed in" means "any account", not "family".
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The fields a write actually changes; unchanged values are not affected.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Public profile. The group member list and the "Owned by <name>" label need
    // to read other users' documents. INVARIANT: never add a non-public field to
    // this document — rules cannot restrict fields on read.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{groupId} {
      // `get` is open to any signed-in user: the invite page previews a group
      // before the visitor joins, and it requires the unguessable document id.
      allow get: if signedIn();

      // `list` is members-only, so the user's home screen can enumerate their own
      // groups without exposing the whole collection.
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      // Groups this caller owns. A list query must be provable before any document is
      // read, and the membership rule above cannot prove a query filtered on `ownerId`.
      allow list: if signedIn() && request.auth.uid == resource.data.ownerId;

      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.members == [request.auth.uid];

      // Incremental and field-bounded: rename, self-join, self-leave, or the
      // owner handing the group to another member so it survives them deleting
      // their account. Only that last case changes `ownerId`.
      allow update: if signedIn()
                    && (
                      // the owner renames the group
                      (request.auth.uid == resource.data.ownerId
                       && changed().hasOnly(['name']))
                      ||
                      // self-join: exactly one member added, and it is the caller
                      (changed().hasOnly(['members'])
                       && !(request.auth.uid in resource.data.members)
                       && request.auth.uid in request.resource.data.members
                       && request.resource.data.members.hasAll(resource.data.members)
                       && request.resource.data.members.size()
                          == resource.data.members.size() + 1)
                      ||
                      // self-leave: exactly one member removed, and it is the
                      // caller (the owner cannot leave their own group)
                      (changed().hasOnly(['members'])
                       && request.auth.uid != resource.data.ownerId
                       && request.auth.uid in resource.data.members
                       && !(request.auth.uid in request.resource.data.members)
                       && resource.data.members.hasAll(request.resource.data.members)
                       && request.resource.data.members.size()
                          == resource.data.members.size() - 1)
                      ||
                      // owner relinquish: hand the group to a remaining member
                      // and remove yourself, atomically
                      (request.auth.uid == resource.data.ownerId
                       && request.auth.uid in resource.data.members
                       && changed().hasOnly(['ownerId', 'members'])
                       && request.resource.data.ownerId != resource.data.ownerId
                       && request.resource.data.ownerId in resource.data.members
                       && !(request.auth.uid in request.resource.data.members)
                       && resource.data.members.hasAll(request.resource.data.members)
                       && request.resource.data.members.size()
                          == resource.data.members.size() - 1)
                    );

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;
    }

    match /wishlists/{wishlistId} {
      // DELIBERATELY OPEN to any signed-in user, and that includes LISTING the
      // whole collection. The app only ever queries the viewer's own wishlists
      // and the wishlists shared with a group they are in, but Firestore cannot
      // express "shared with a group I belong to" as a provable list query, so a
      // crafted client can enumerate every wishlist — and read the group ids in
      // them. Item reads and claim writes are still gated on the parent.
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.sharedWithGroups == [];
      allow update: if signedIn()
                    && request.auth.uid == resource.data.ownerId
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      match /items/{itemId} {
        function parent() {
          return get(/databases/$(database)/documents/wishlists/$(wishlistId)).data;
        }
        function isParentOwner() {
          return signedIn() && request.auth.uid == parent().ownerId;
        }
        function canReadParent() {
          return isParentOwner()
                 || (signedIn()
                     && parent().keys().hasAny(['sharedWithGroups'])
                     && parent().sharedWithGroups.size() > 0);
        }

        // A claim is one key in `claims`, mapping a uid to the time it was
        // claimed. The helpers tolerate an absent map (a last unclaim, or a
        // document written before it existed) but not a malformed one.
        function storedClaims() {
          return resource.data.keys().hasAny(['claims'])
                 ? resource.data.claims : {};
        }
        function requestClaims() {
          return request.resource.data.keys().hasAny(['claims'])
                 ? request.resource.data.claims : {};
        }

        // A reader may affect only their own key, and a key they add must be a
        // timestamp. A removed key is allowed, which is the unclaim path.
        function ownClaimOnly() {
          return requestClaims() is map
                 && storedClaims() is map
                 && requestClaims().diff(storedClaims()).affectedKeys()
                      .hasOnly([request.auth.uid])
                 && (!(request.auth.uid in requestClaims())
                     || requestClaims()[request.auth.uid] is timestamp);
        }

        // The cap holds on every write. A document without `claimLimit`
        // (written before the migration) errors here and is denied until it is
        // migrated, which the release runbook does before the rules deploy.
        function claimsFitLimit() {
          return requestClaims() is map
                 && (request.resource.data.claimLimit == 0
                     || requestClaims().size()
                        <= request.resource.data.claimLimit);
        }

        function limitIsValid() {
          return request.resource.data.claimLimit is int
                 && request.resource.data.claimLimit >= 0;
        }

        // The owner may change content and the limit, but never below the
        // people who already claimed.
        function ownerLimitIsValid() {
          return limitIsValid() && claimsFitLimit();
        }

        // The owner's content edit is field-scoped so a whole-document write
        // cannot drop a reader's claim, and the limit holds.
        function ownerEditsContent() {
          return changed().hasOnly(
                   ['name', 'description', 'url', 'claimLimit'])
                 && ownerLimitIsValid();
        }

        // The owner may also clear every claim in one write. The value must
        // stay a map and must end empty, so an owner can remove claims but
        // never add or rewrite one.
        function ownerClearsClaims() {
          return changed().hasOnly(['claims'])
                 && requestClaims() is map
                 && requestClaims().size() == 0;
        }

        // Narrower than the wishlist read above: an item is readable only by its
        // wishlist's owner, or when that wishlist has been shared with a group.
        allow read: if canReadParent();

        // An item may not be created already claimed, and every new write
        // carries a non-negative integer limit. An old client that omits it is
        // refused; the release window updates clients before this deploys.
        allow create: if isParentOwner()
                      && limitIsValid()
                      && requestClaims() is map
                      && requestClaims().size() == 0;

        allow delete: if isParentOwner();

        // The owner's update is field-scoped so a whole-document write cannot
        // drop a reader's claim, and it is refused until the document has a
        // limit (a legacy document is migrated before these rules deploy). A
        // separate reset path clears every claim, and only down to empty.
        allow update: if (isParentOwner()
                          && resource.data.keys().hasAny(['claimLimit'])
                          && (ownerEditsContent() || ownerClearsClaims()))
                      || (canReadParent()
                          && changed().hasOnly(['claims'])
                          && ownClaimOnly()
                          && claimsFitLimit());
      }
    }
  }
}
